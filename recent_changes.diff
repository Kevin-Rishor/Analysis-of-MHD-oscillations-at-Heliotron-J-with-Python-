+            signals[coil] = ys
+            if time_sec is None:
+                time_sec = t_s
+                n_samples = len(t_s)
+                sample_idx = min(100, n_samples - 1) if n_samples > 1 else 0
+                dt = (t_s[sample_idx] - t_s[0]) / float(sample_idx) if sample_idx > 0 else 1e-6
+                fs = 1.0 / dt
+
+        if "MP1" not in signals:
+            print("Error: MP1 reference channel missing; aborting shot.")
